{
  "manifest_version": 3,
  "name": "Inbox Signal",
  "version": "0.1.0",
  "description": "Review the open Gmail message with a Jev powered risk check.",
  "minimum_chrome_version": "92",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_title": "Inbox Signal",
    "default_popup": "popup/popup.html"
  }
}
